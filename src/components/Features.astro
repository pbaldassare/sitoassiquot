---
import site from '@/content/site.it.json';
const f = site.features;
---

<section id="funzionalita" class="section scroll-mt-16" aria-labelledby="features-title">
  <div class="container-content">
    <div class="grid gap-6 lg:grid-cols-[1fr_1.1fr] lg:items-end">
      <h2 id="features-title" class="display h-section text-navy-800">{f.title}</h2>
      <p class="lead text-steel">{f.intro}</p>
    </div>

    <div class="mt-14 grid grid-cols-[minmax(0,1fr)] gap-6 lg:grid-cols-[22rem_minmax(0,1fr)] lg:gap-10" data-tabs>
      <div role="tablist" aria-label="Aree della piattaforma" aria-orientation="vertical" class="flex gap-2 overflow-x-auto pb-1 lg:flex-col lg:overflow-visible lg:pb-0">
        {
          f.blocks.map((b, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${b.id}`}
              aria-controls={`panel-${b.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="group shrink-0 rounded-card border-2 border-transparent bg-white px-5 py-4 text-left transition-colors hover:border-navy-800/30 aria-selected:border-navy-800 aria-selected:bg-navy-800 aria-selected:text-white lg:px-6 lg:py-5"
            >
              <span class="flex items-baseline justify-between gap-4">
                <span class="wide text-lg font-bold whitespace-nowrap">{b.title}</span>
                <span class="num text-small font-semibold text-steel group-aria-selected:text-navy-300">{b.items.length}</span>
              </span>
              <span class="mt-1 hidden text-[0.9375rem] text-steel group-aria-selected:text-navy-100 lg:block">{b.summary}</span>
            </button>
          ))
        }
      </div>

      <div class="space-y-4">
        {
          f.blocks.map((b, i) => (
            <div role="tabpanel" id={`panel-${b.id}`} aria-labelledby={`tab-${b.id}`} tabindex="0" class="rounded-card bg-white p-6 sm:p-9 lg:min-h-full" data-panel data-first={i === 0 ? 'true' : undefined}>
              <h3 class="display text-[1.75rem] leading-tight text-navy-800">{b.title}</h3>
              <p class="mt-2 text-steel lg:hidden">{b.summary}</p>
              <ul class="up-list mt-7 grid gap-x-10 gap-y-4 md:grid-cols-2">
                {b.items.map((item) => (
                  <li class="text-[0.9875rem] leading-relaxed text-ink">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-tabs]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const select = (i: number, focus = false) => {
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', String(k === i));
        t.tabIndex = k === i ? 0 : -1;
      });
      panels.forEach((p, k) => (p.hidden = k !== i));
      if (focus) tabs[i].focus();
    };
    // Senza JS restano visibili tutte le aree, una sotto l'altra
    panels.forEach((p) => {
      if (!p.dataset.first) p.hidden = true;
    });
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const next = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
        if (next) {
          e.preventDefault();
          select((i + next + tabs.length) % tabs.length, true);
        } else if (e.key === 'Home') {
          e.preventDefault();
          select(0, true);
        } else if (e.key === 'End') {
          e.preventDefault();
          select(tabs.length - 1, true);
        }
      });
    });
  }
</script>
