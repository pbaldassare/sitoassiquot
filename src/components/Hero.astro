---
import site from '@/content/site.it.json';
import Icon from '@/components/Icon.astro';
const h = site.hero;
const b = h.board;
const eur = (n: number) => new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR' }).format(n);
const plate = `${b.plate.slice(0, 2)} ${b.plate.slice(2, 5)} ${b.plate.slice(5)}`;
const r = site.rates;
const v = r.vehicles as Record<string, (boolean | string | null)[]>;
const tags = ['Auto', 'Moto', 'Autocarri'];
const tape = [...r.base, ...r.convention].map((name) => ({
  name,
  what: tags.filter((_, i) => v[name]?.[i]).join(' · '),
  conv: r.convention.includes(name),
}));
---

<section id="hero" class="relative overflow-hidden" aria-labelledby="hero-title">
  <div class="container-content grid gap-12 pt-10 pb-16 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)] lg:items-center lg:gap-14 lg:pt-16 lg:pb-24">
    <div>
      <h1 id="hero-title" class="display h-display text-navy-800">
        <span class="block">{h.titleA}</span>
        <span class="block text-crimson-700">{h.titleB}</span>
        <span class="block">{h.titleC}</span>
      </h1>
      <p class="lead mt-7 text-steel">{h.subtitle}</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href={h.ctaPrimary.href} class="btn btn-primary">
          {h.ctaPrimary.label}
          <Icon name="arrow-right" class="icon h-5 w-5" />
        </a>
        <a href={h.ctaSecondary.href} class="btn btn-outline">{h.ctaSecondary.label}</a>
      </div>
      <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-[0.9375rem] font-semibold text-graphite">
        {
          h.facts.map((f) => (
            <li class="flex items-center gap-2">
              <Icon name="check" class="h-4 w-4 text-crimson-700" strokeWidth={2.75} />
              {f}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Tabellone: la targa entra, le compagnie rispondono, il premio migliore sale in cima -->
    <figure class="on-navy relative">
      <div class="board overflow-hidden rounded-card bg-navy-950 text-white shadow-lift" data-board data-state="done">
        <div class="flex items-center justify-between gap-4 border-b border-white/10 px-5 py-4 sm:px-6">
          <p class="wide text-[0.9375rem] font-bold">{b.title}</p>
          <p class="flex items-center gap-2 text-small text-navy-300" data-board-status>
            <span class="h-2 w-2 rounded-full bg-green-300" aria-hidden="true"></span>
            <span data-board-status-text>{b.ready}</span>
          </p>
        </div>

        <div class="grid gap-4 px-5 pt-5 sm:grid-cols-[auto_1fr] sm:items-center sm:px-6">
          <div class="flex items-stretch overflow-hidden rounded-md bg-white text-ink ring-2 ring-white/20">
            <span class="flex w-7 flex-col items-center justify-end bg-navy-800 pb-1 text-[0.625rem] font-bold text-white">I</span>
            <span class="sr-only">{b.plateLabel}:</span>
            <span class="num wide px-3 py-1.5 text-xl font-extrabold tracking-[0.14em]" data-plate data-plate-full={plate}>{plate}</span><span class="board-caret hidden self-center" data-caret aria-hidden="true"></span>
          </div>
          <div class="text-small">
            <p class="flex items-center gap-1.5 font-semibold text-green-300" data-ania>
              <Icon name="check-circle" class="h-4 w-4" />
              {b.ania}
            </p>
            <p class="text-navy-300">{b.vehicle} · {b.holder}</p>
          </div>
        </div>

        <div class="relative mt-5 h-px bg-white/10" aria-hidden="true">
          <span class="board-scan absolute inset-y-0 left-0 hidden w-1/3 bg-crimson-300" data-scan></span>
        </div>

        <table class="w-full text-left">
          <caption class="sr-only">Esempio di confronto tra compagnie</caption>
          <thead class="text-[0.75rem] font-semibold tracking-[0.06em] text-navy-300 uppercase">
            <tr>
              <th scope="col" class="px-5 pt-4 pb-2 font-semibold sm:px-6">{b.colCompany}</th>
              <th scope="col" class="px-2 pt-4 pb-2 text-right font-semibold">{b.colPremium}</th>
              <th scope="col" class="px-5 pt-4 pb-2 text-right font-semibold sm:px-6">{b.colFee}</th>
            </tr>
          </thead>
          <tbody>
            {
              b.rows.map((row, i) => (
                <tr class="board-row border-t border-white/8" data-row data-best={i === 0 ? 'true' : 'false'} style={`--d:${i * 110}ms`}>
                  <th scope="row" class="px-5 py-3 font-semibold sm:px-6">
                    <span class="flex items-center gap-2.5">
                      {row.name}
                      {i === 0 && <span class="rounded-sm bg-crimson-300 px-1.5 py-0.5 text-[0.6875rem] font-bold tracking-wide text-navy-950 uppercase">Migliore</span>}
                    </span>
                  </th>
                  <td class="num px-2 py-3 text-right font-semibold" data-premium={row.premium}>{eur(row.premium)}</td>
                  <td class="num px-5 py-3 text-right text-navy-300 sm:px-6" data-fee={row.fee}>{eur(row.fee)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <div class="flex items-center justify-between gap-3 border-t border-white/10 px-5 py-4 sm:px-6">
          <button type="button" class="inline-flex min-h-11 items-center gap-2 rounded-ctl px-2 text-small font-semibold text-navy-300 transition-colors hover:text-white" data-replay>
            <Icon name="refresh-cw" class="h-4 w-4" />
            {b.replay}
          </button>
          <span class="inline-flex min-h-10 items-center rounded-ctl bg-crimson-700 px-4 text-small font-bold" aria-hidden="true">{b.emit}</span>
        </div>
      </div>
      <figcaption class="mt-3 text-small text-steel">{b.disclaimer}</figcaption>
    </figure>
  </div>

  <!-- Nastro delle compagnie, come un listino di borsa -->
  <div class="ticker overflow-hidden border-y border-navy-950 bg-navy-900 text-white" aria-label="Compagnie interrogabili" role="region">
    <ul class="ticker-track py-3.5">
      {
        [0, 1].map((copy) =>
          tape.map((c) => (
            <li class="flex shrink-0 items-center gap-3 px-6" aria-hidden={copy === 1 ? 'true' : undefined}>
              <Icon name="trending-up" class="h-4 w-4 text-crimson-300" strokeWidth={2.25} />
              <span class="wide font-bold whitespace-nowrap">{c.name}</span>
              <span class="text-small whitespace-nowrap text-navy-300">{c.conv ? 'In convenzione' : c.what}</span>
            </li>
          ))
        )
      }
    </ul>
  </div>
</section>

<script>
  const board = document.querySelector<HTMLElement>('[data-board]');
  if (board) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const plate = board.querySelector<HTMLElement>('[data-plate]')!;
    const caret = board.querySelector<HTMLElement>('[data-caret]')!;
    const scan = board.querySelector<HTMLElement>('[data-scan]')!;
    const ania = board.querySelector<HTMLElement>('[data-ania]')!;
    const statusText = board.querySelector<HTMLElement>('[data-board-status-text]')!;
    const replay = board.querySelector<HTMLButtonElement>('[data-replay]')!;
    const full = plate.dataset.plateFull ?? '';
    const ready = statusText.textContent ?? '';
    const searching = 'Interrogo le compagnie…';
    const eur = new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR' });
    const cells = Array.from(board.querySelectorAll<HTMLElement>('[data-premium],[data-fee]'));
    let timers: number[] = [];
    const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));

    const countUp = (el: HTMLElement) => {
      const target = Number(el.dataset.premium ?? el.dataset.fee);
      const start = performance.now();
      const tick = (t: number) => {
        const p = Math.min(1, (t - start) / 700);
        el.textContent = eur.format(target * (1 - Math.pow(1 - p, 4)));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    const run = () => {
      timers.forEach(clearTimeout);
      timers = [];
      board.dataset.state = 'typing';
      plate.textContent = '';
      caret.classList.remove('hidden');
      ania.style.visibility = 'hidden';
      statusText.textContent = searching;
      replay.disabled = true;
      [...full].forEach((ch, i) => later(() => (plate.textContent += ch), 120 + i * 85));
      const typed = 120 + full.length * 85;
      later(() => {
        caret.classList.add('hidden');
        ania.style.visibility = '';
        scan.classList.remove('hidden');
      }, typed + 150);
      later(() => {
        scan.classList.add('hidden');
        board.dataset.state = 'done';
        cells.forEach(countUp);
        statusText.textContent = ready;
        replay.disabled = false;
      }, typed + 1300);
    };

    if (!reduce) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            run();
            io.disconnect();
          }
        },
        { threshold: 0.35 }
      );
      io.observe(board);
      replay.addEventListener('click', run);
    } else {
      replay.hidden = true;
    }
  }
</script>
