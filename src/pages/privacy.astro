---
import Base from '@/layouts/Base.astro';
import site from '@/content/site.it.json';
const p = site.privacy;
const t = p.cookieTable;
---

<Base title={p.metaTitle} description="Informativa sul trattamento dei dati personali e sui cookie del sito ASSIQUOT, titolare Assisoft S.r.l." minimal>
  <article class="section">
    <div class="container-content max-w-3xl">
      <h1 class="display h-section text-navy-800">{p.title}</h1>
      <p class="mt-4 text-small text-steel">{p.updated}</p>
      <p class="lead mt-6 text-steel">{p.intro}</p>

      <nav aria-label="Indice" class="mt-10 rounded-card bg-white p-6">
        <ol class="grid gap-1 text-[0.9375rem] sm:grid-cols-2">
          {
            p.sections.map((s) => (
              <li>
                <a href={`#${s.id}`} class="inline-flex min-h-9 items-center font-semibold text-navy-800 hover:text-crimson-700 hover:underline">
                  {s.title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      {
        p.sections.map((s) => (
          <section id={s.id} class="mt-12 scroll-mt-24">
            <h2 class="wide text-h3 font-bold text-navy-800">{s.title}</h2>
            {s.paragraphs.map((para) => (
              <p class="mt-3 text-graphite">{para}</p>
            ))}
            {s.id === 'cookie' && (
              <>
                <div class="mt-6 overflow-x-auto rounded-card border border-line bg-white">
                  <table class="w-full min-w-[32rem] text-left text-[0.9375rem]">
                    <caption class="sr-only">{t.caption}</caption>
                    <thead class="bg-navy-900 text-small text-white">
                      <tr>
                        {t.head.map((h) => (
                          <th scope="col" class="px-4 py-3 font-semibold">
                            {h}
                          </th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {t.rows.map((row) => (
                        <tr>
                          {row.map((cell, i) => (i === 0 ? <th scope="row" class="px-4 py-3 font-semibold text-navy-800">{cell}</th> : <td class="px-4 py-3 text-graphite">{cell}</td>))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <button type="button" class="btn btn-outline mt-6" data-cookie-open>
                  {site.footer.cookiePrefs}
                </button>
              </>
            )}
          </section>
        ))
      }
    </div>
  </article>
</Base>
